+{
+	size_t count = sizeof(hakios_interpose_xpc) / sizeof(hakios_interpose_xpc[0]);
+
+	for (size_t i = 0; i < count; i++) {
+		if (hakios_interpose_xpc[i].replacement == replacement) {
+			return (void *)hakios_interpose_xpc[i].replacee;
+		}
+	}
+	return NULL;
