+/* ---- backboardd: the panel stays lit ------------------------------------------------------------ */
+
+/*
+ * With the launch under way, backboardd sets its display blanked and the CoreBrightness backlight
+ * factor to zero (run 33: "[Display] Set Blanked: YES" at 00:07:12, then "[Backlight] Setting
+ * CoreBrightness backlight factor:0.000000"). This phone has no backlight driver to take the zero,
+ * but the blanked state stays inside the window server, and a display that says it is blanked draws
+ * no frame. So the brightness setters of BLControl and the blanking setters of the display are kept
+ * from turning anything off, and every one that was found is named in the log.
+ */
+struct kept_method {
+	SEL selector;
+	IMP original;
+};
+
+static struct kept_method kept_brightness[8], kept_blanked[8];
+static unsigned kept_brightness_count, kept_blanked_count;
+
+static IMP
+kept_original(struct kept_method *table, unsigned count, SEL selector)
+{
+	for (unsigned i = 0; i < count; i++) {
+		if (sel_isEqual(table[i].selector, selector)) {
+			return table[i].original;
+		}
+	}
+	return NULL;
+}
+
+/* a float factor and, after it, a fade duration: in s0 and s1 whatever the second one's type is */
+static void
+keep_the_panel_lit(id self, SEL selector, float factor, float fade)
+{
+	IMP original = kept_original(kept_brightness, kept_brightness_count, selector);
+	static unsigned said;
+
+	if (original == NULL) {
+		return;
+	}
+	if (!(factor > 0.01f)) {
+		if (said++ < 4) {
+			say("hakios: backlight %s: %.3f -> 1.000\n", sel_getName(selector), (double)factor);
+		}
+		factor = 1.0f;
+	}
+	((void (*)(id, SEL, float, float))original)(self, selector, factor, fade);
+}
+
+static void
+keep_the_display_unblanked(id self, SEL selector, BOOL blanked)
+{
+	IMP original = kept_original(kept_blanked, kept_blanked_count, selector);
+	static unsigned said;
+
+	if (original == NULL) {
+		return;
+	}
+	if (blanked) {
+		if (said++ < 4) {
+			say("hakios: %s: YES ignored\n", sel_getName(selector));
+		}
+		return;
+	}
+	((void (*)(id, SEL, BOOL))original)(self, selector, blanked);
+}
+
+static void
+keep_a_table(const char *class_name, const char *prefix, struct kept_method *table, unsigned *count,
+    unsigned most, IMP replacement)
+{
+	Class cls = objc_getClass(class_name);
+
+	if (cls == NULL) {
+		return;                                 /* (the class is not here: nothing to keep) */
+	}
+	for (; cls != NULL && *count < most; cls = class_getSuperclass(cls)) {
+		unsigned total = 0, found = 0;
+		Method *methods = class_copyMethodList(cls, &total);
+
+		if (methods == NULL) {
+			continue;
+		}
+		for (unsigned i = 0; i < total && *count < most; i++) {
+			SEL selector = method_getName(methods[i]);
+
+			if (strncmp(sel_getName(selector), prefix, strlen(prefix)) != 0) {
+				continue;
+			}
+			table[*count].selector = selector;
+			table[*count].original = method_getImplementation(methods[i]);
+			method_setImplementation(methods[i], replacement);
+			(*count)++;
+			found++;
+		}
+		free(methods);
+		if (found != 0) {
+			say("hakios: %s: %u %s hooked\n", class_name, found, prefix);
+		}
+	}
+}
+
+/*
+ * The classes are looked for by name, since which of CoreBrightness's and CoreAnimation's own ones
+ * are here differs with the moment (BLControl and BKDisplay were not registered yet when the first
+ * pass ran in run 34). The scan is therefore tried again a few times after the launch starts.
+ */
+static const char *const panel_classes[] = {
+	"CAWindowServerDisplay", "CAWindowServer", "CADisplay", "BKDisplay", "BKDisplayController",
+	"BLSBacklight", "BLControl", "BLBacklight", "CBrightnessSystem", "BrightnessSystem",
+	"BrightnessSystemClient",
+};
+#define PANEL_CLASSES   (sizeof(panel_classes) / sizeof(panel_classes[0]))
+
+static bool panel_scanned[PANEL_CLASSES];
+
+static unsigned
+keep_blanking_in(Class cls, const char *class_name, unsigned most)
+{
+	unsigned found = 0;
+
+	for (; cls != NULL; cls = class_getSuperclass(cls)) {
+		unsigned total = 0;
+		Method *methods = class_copyMethodList(cls, &total);
+
+		if (methods == NULL) {
+			continue;
+		}
+		for (unsigned i = 0; i < total; i++) {
+			const char *name = sel_getName(method_getName(methods[i]));
+
+			if (strcmp(name, "setBlanked:") != 0 && strcmp(name, "_setBlanked:") != 0 &&
+			    strcmp(name, "setDisplayBlanked:") != 0) {
+				if (strstr(name, "Blanked") != NULL || strstr(name, "blanked") != NULL) {
+					say("hakios: %s %s is left as it is\n", class_name, name);
+				}
+				continue;
+			}
+			if (kept_blanked_count >= most ||
+			    kept_original(kept_blanked, kept_blanked_count, method_getName(methods[i])) != NULL) {
+				continue;               /* (the same name on two classes: one original will not do both) */
+			}
+			kept_blanked[kept_blanked_count].selector = method_getName(methods[i]);
+			kept_blanked[kept_blanked_count].original = method_getImplementation(methods[i]);
+			method_setImplementation(methods[i], (IMP)keep_the_display_unblanked);
+			kept_blanked_count++;
+			found++;
+		}
+		free(methods);
+	}
+	if (found != 0) {
+		say("hakios: %s: %u blanking setter%s hooked\n", class_name, found, found == 1 ? "" : "s");
+	}
+	return found;
+}
+
+/* the first pass also says where in this process a setBlanked: lives at all, for the next run */
+static void
+find_blanking_classes(void)
+{
+	int count = objc_getClassList(NULL, 0);
+	Class *classes;
+	unsigned said = 0;
+
+	if (count <= 0 || (classes = malloc((size_t)count * sizeof(Class))) == NULL) {
+		return;
+	}
+	count = objc_getClassList(classes, count);
+	for (int i = 0; i < count && said < 8; i++) {
+		const char *name = class_getName(classes[i]);
+		Class cls;
+
+		if (strstr(name, "Display") == NULL && strncmp(name, "BK", 2) != 0 && strncmp(name, "BL", 2) != 0) {
+			continue;
+		}
+		for (cls = classes[i]; cls != NULL && said < 8; cls = class_getSuperclass(cls)) {
+			unsigned total = 0;
+			Method *methods = class_copyMethodList(cls, &total);
+
+			if (methods == NULL) {
+				continue;
+			}
+			for (unsigned j = 0; j < total && said < 8; j++) {
+				const char *selector = sel_getName(method_getName(methods[j]));
+
+				if (strcmp(selector, "setBlanked:") == 0 || strcmp(selector, "_setBlanked:") == 0) {
+					say("hakios: %s has %s\n", class_getName(cls), selector);
+					said++;
+				}
+			}
+			free(methods);
+		}
+	}
+	free(classes);
+}
+
+static void
+backlight_fixes(void)
+{
+	const unsigned most_brightness = sizeof(kept_brightness) / sizeof(kept_brightness[0]);
+	const unsigned most_blank = sizeof(kept_blanked) / sizeof(kept_blanked[0]);
+
+	for (unsigned i = 0; i < PANEL_CLASSES; i++) {
+		Class cls;
+
+		if (panel_scanned[i] || (cls = objc_getClass(panel_classes[i])) == NULL) {
+			continue;
+		}
+		panel_scanned[i] = true;
+		keep_a_table(panel_classes[i], "setBacklightFactor", kept_brightness, &kept_brightness_count,
+		    most_brightness, (IMP)keep_the_panel_lit);
+		(void)keep_blanking_in(cls, panel_classes[i], most_blank);
+	}
+	{
+		static unsigned last_brightness, last_blanking, passes;
+
+		if (passes++ == 0) {
+			find_blanking_classes();
+		}
+
+		if (kept_brightness_count != last_brightness || kept_blanked_count != last_blanking) {
+			last_brightness = kept_brightness_count;
+			last_blanking = kept_blanked_count;
+			say("hakios: panel: %u brightness, %u blanking setters kept\n", kept_brightness_count,
+			    kept_blanked_count);
+		}
+	}
+}
+
+static void
+panel_retry(unsigned left)
+{
+	backlight_fixes();
+	if (left > 1) {
+		dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 500 * NSEC_PER_MSEC),
+		    dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{
+			panel_retry(left - 1);
+		});
+	}
+}
