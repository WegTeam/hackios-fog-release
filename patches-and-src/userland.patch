+/* One thread's stack, one frame a line: /dev/console cuts a long line and drops it when busy. */
+static void
+say_thread_stack(int index, bool main_thread, uint64_t pc, uint64_t fp)
+{
+	char line[300];
+	char symbol[220];
+	int depth;
+
+	symbol_of(pc, symbol, sizeof(symbol));
+	snprintf(line, sizeof(line), "hakios: t%d%s %s\n", index, main_thread ? "(main)" : "", symbol);
+	write(say_fd, line, strlen(line));
+	for (depth = 1; depth <= 14 && fp != 0; depth++) {
+		uint64_t frame[2] = { 0, 0 };
+		vm_size_t got = 0;
+
+		if ((fp & 7) != 0 || fp < 0x10000) {
+			break;
+		}
+		if (vm_read_overwrite(mach_task_self(), (vm_address_t)fp, sizeof(frame),
+		    (vm_address_t)frame, &got) != KERN_SUCCESS || got != sizeof(frame)) {
+			break;
+		}
+		if (frame[1] < 0x1000) {
+			break;
+		}
+		symbol_of(frame[1], symbol, sizeof(symbol));
+		snprintf(line, sizeof(line), "hakios: t%d#%d %s\n", index, depth, symbol);
+		write(say_fd, line, strlen(line));
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+}
